{
  "name": "lookaberry",
  "version": "0.1.0",
  "description": "AI GTM Outbound Engine (API + MCP Server)",
  "main": "dist/src/index.js",
  "bin": {
    "lookaberry-mcp": "dist/src/mcp/transports/stdio.js"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "mcp:stdio": "tsx src/mcp/transports/stdio.ts",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "tsx tests/mcp-client-smoke.ts",
    "test:beta": "tsx tests/beta-test-account.ts"
  },
  "keywords": [
    "gtm",
    "mcp",
    "sales",
    "pgvector",
    "outbound",
    "ai-agent",
    "b2b"
  ],
  "author": "LookaBerry Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@mozilla/readability": "^0.6.0",
    "@prisma/client": "^6.4.1",
    "axios": "^1.8.1",
    "bullmq": "^5.41.6",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.6.0",
    "jsdom": "^26.0.0",
    "nodemailer": "^9.0.5",
    "openai": "^4.86.1",
    "pg": "^8.13.3",
    "turndown": "^7.2.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.3"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.11",
    "@types/turndown": "^5.0.6",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
