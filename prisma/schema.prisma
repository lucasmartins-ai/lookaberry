model Relationship {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  personId         String    @map("person_id") @db.Uuid
  sourceId         String?   @map("source_id") @db.Uuid
  relationshipType String    @map("relationship_type") @db.VarChar(100)
  confidence       Decimal   @default(1.0000) @db.Decimal(5, 4)
  startedAt        DateTime? @map("started_at") @db.Timestamptz(6)
  endedAt          DateTime? @map("ended_at") @db.Timestamptz(6)
  metadata         Json      @default("{}")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  company Company @relation("CompanyRelationships", fields: [companyId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  source  Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([companyId, personId, relationshipType], map: "uq_relationships_company_person_type")
  @@index([companyId], map: "idx_relationships_company_id")
  @@index([personId], map: "idx_relationships_person_id")
  @@index([sourceId], map: "idx_relationships_source_id")
  @@map("relationships")
}

model Interaction {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  leadId          String?  @map("lead_id") @db.Uuid
  companyId       String?  @map("company_id") @db.Uuid
  personId        String?  @map("person_id") @db.Uuid
  sourceId        String?  @map("source_id") @db.Uuid
  channel         String   @db.VarChar(100)
  interactionType String   @map("interaction_type") @db.VarChar(100)
  externalId      String?  @map("external_id") @db.VarChar(255)
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  content         String?  @db.Text
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  person  Person?  @relation(fields: [personId], references: [id], onDelete: SetNull)
  source  Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([sourceId, externalId], map: "idx_interactions_source_external_id")
  @@index([leadId, occurredAt], map: "idx_interactions_lead_occurred")
  @@index([companyId, occurredAt], map: "idx_interactions_company_occurred")
  @@index([personId, occurredAt], map: "idx_interactions_person_occurred")
  @@map("interactions")
}
