datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, uuidOssp(map: "uuid-ossp")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum EmailStatus {
  UNVERIFIED
  VERIFIED
  RISKY
  INVALID
  NOT_FOUND

  @@map("email_status_enum")
}

enum LeadStatus {
  DISCOVERED
  ENRICHED
  READY
  IN_SEQUENCE
  ENGAGED
  REPLIED_POSITIVE
  REPLIED_NEGATIVE
  UNSUBSCRIBED
  BOUNCED

  @@map("lead_status_enum")
}

enum PhoneStatus {
  UNVERIFIED
  VALID
  INVALID

  @@map("phone_status_enum")
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  EXPIRED

  @@map("account_status_enum")
}

enum ChannelType {
  LINKEDIN_CONNECT
  LINKEDIN_MESSAGE
  EMAIL
  MANUAL_TASK

  @@map("channel_enum")
}

enum MessageStatus {
  QUEUED
  SCHEDULED
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  FAILED
  BOUNCED

  @@map("message_status_enum")
}

enum BranchCondition {
  NONE
  OPENED
  NOT_OPENED
  REPLIED
  NOT_REPLIED
  CLICKED
  BOUNCED

  @@map("branch_condition_enum")
}

enum OutreachSequenceStatus {
  ACTIVE
  PAUSED
  COMPLETED

  @@map("outreach_sequence_status_enum")
}

enum InteractionType {
  OPEN
  CLICK
  REPLY
  BOUNCE

  @@map("interaction_type_enum")
}

enum FeedbackSentiment {
  POSITIVE
  NEGATIVE
  NEUTRAL
  AMBIGUOUS

  @@map("feedback_sentiment_enum")
}

enum EvidenceClassification {
  FACT
  INFERENCE
  LLM_INFERENCE
  USER_PROVIDED
  UNVERIFIED

  @@map("evidence_classification_enum")
}

model IcpProfile {
  id                String                       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name              String                       @db.VarChar(255)
  websiteUrl        String?                      @map("website_url") @db.VarChar(500)
  description       String                       @db.Text
  targetIndustries  String[]                     @default([]) @map("target_industries")
  companySizeMin    Int?                         @default(1) @map("company_size_min")
  companySizeMax    Int?                         @default(10000) @map("company_size_max")
  targetGeos        String[]                     @default([]) @map("target_geos")
  techStackKeywords String[]                     @default([]) @map("tech_stack_keywords")
  valuePropositions Json                         @default("[]") @map("value_propositions")
  embedding         Unsupported("vector(1536)")?
  createdAt         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  personas  IcpPersona[]
  campaigns Campaign[]

  @@map("icp_profiles")
}

model IcpPersona {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  icpId            String   @map("icp_id") @db.Uuid
  jobTitles        String[] @map("job_titles")
  seniorityLevels  String[] @map("seniority_levels")
  responsibilities String?  @db.Text
  priorityScore    Int      @default(10) @map("priority_score")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  icpProfile IcpProfile @relation(fields: [icpId], references: [id], onDelete: Cascade)

  @@map("icp_personas")
}

model Company {
  id             String                       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  domain         String                       @unique @db.VarChar(255)
  name           String                       @db.VarChar(255)
  linkedinUrl    String?                      @map("linkedin_url") @db.VarChar(500)
  employeeCount  Int?                         @map("employee_count")
  industry       String?                      @db.VarChar(255)
  country        String?                      @db.VarChar(100)
  techStack      String[]                     @default([]) @map("tech_stack")
  description    String?                      @db.Text
  icpFitScore    Decimal?                     @default(0.00) @map("icp_fit_score") @db.Decimal(5, 2)
  embedding      Unsupported("vector(1536)")?
  lastEnrichedAt DateTime?                    @map("last_enriched_at") @db.Timestamptz(6)
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  signals         IntentSignal[]
  leads           Lead[]
  enrichmentLogs  EnrichmentLog[]
  people          Person[]
  identities      Identity[]
  companyEvidence CompanyEvidence[]
  observations    Observation[]
  relationships   Relationship[]    @relation("CompanyRelationships")
  interactions    Interaction[]

  @@index([domain], map: "idx_companies_domain")
  @@map("companies")
}

model IntentSignal {
  id                    String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId             String                 @map("company_id") @db.Uuid
  providerId            String?                @map("provider_id") @db.VarChar(100)
  sourceId              String?                @map("source_id") @db.Uuid
  companyEvidenceId     String?                @map("company_evidence_id") @db.Uuid
  signalType            String                 @map("signal_type") @db.VarChar(100)
  source                String                 @db.VarChar(100)
  sourceUrl             String?                @map("source_url") @db.VarChar(1000)
  title                 String                 @db.VarChar(500)
  rawPayload            Json?                  @default("{}") @map("raw_payload")
  normalizedData        Json                   @default("{}") @map("normalized_data")
  metadata              Json                   @default("{}")
  summary               String                 @db.Text
  intentWeight          Decimal                @default(50.00) @map("intent_weight") @db.Decimal(5, 2)
  confidence            Decimal                @default(1.0000) @db.Decimal(5, 4)
  sourceQuality         Decimal                @default(0.5000) @map("source_quality") @db.Decimal(5, 4)
  cost                  Decimal                @default(0.0000) @db.Decimal(8, 4)
  evidenceClassification EvidenceClassification @default(UNVERIFIED) @map("evidence_classification")
  contentHash           String?                @map("content_hash") @db.VarChar(128)
  deduplicationKey      String?                @map("deduplication_key") @db.VarChar(255)
  observedAt            DateTime               @default(now()) @map("observed_at") @db.Timestamptz(6)
  ttlDays               Int                    @default(30) @map("ttl_days")
  detectedAt            DateTime               @default(now()) @map("detected_at") @db.Timestamptz(6)
  expiresAt             DateTime               @map("expires_at") @db.Timestamptz(6)
  isActive              Boolean                @default(true) @map("is_active")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  providerSource  Source?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  companyEvidence CompanyEvidence? @relation(fields: [companyEvidenceId], references: [id], onDelete: SetNull)
  messages        OutreachMessage[]

  @@index([companyId, isActive], map: "idx_intent_signals_company_active")
  @@index([isActive, expiresAt, intentWeight(sort: Desc)], map: "idx_intent_signals_active_expiry_weight")
  @@index([companyId, signalType, deduplicationKey], map: "idx_intent_signals_company_type_dedup")
  @@index([providerId], map: "idx_intent_signals_provider_id")
  @@index([sourceId], map: "idx_intent_signals_source_id")
  @@index([observedAt], map: "idx_intent_signals_observed_at")
  @@map("intent_signals")
}

model Lead {
  id                 String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId          String      @map("company_id") @db.Uuid
  firstName          String      @map("first_name") @db.VarChar(150)
  lastName           String?     @map("last_name") @db.VarChar(150)
  fullName           String      @map("full_name") @db.VarChar(300)
  title              String      @db.VarChar(255)
  seniority          String?     @db.VarChar(100)
  linkedinUrl        String?     @map("linkedin_url") @db.VarChar(500)
  email              String?     @db.VarChar(255)
  emailStatus        EmailStatus @default(UNVERIFIED) @map("email_status")
  phone              String?     @db.VarChar(50)
  phoneStatus        PhoneStatus @default(UNVERIFIED) @map("phone_status")
  location           String?     @db.VarChar(255)
  icpScore           Decimal     @default(0.00) @map("icp_score") @db.Decimal(5, 2)
  intentScore        Decimal     @default(0.00) @map("intent_score") @db.Decimal(5, 2)
  totalPriorityScore Decimal?    @map("total_priority_score") @db.Decimal(5, 2)
  personId           String?     @map("person_id") @db.Uuid
  timezone           String?     @db.VarChar(50)
  status             LeadStatus  @default(DISCOVERED)
  metadata           Json?       @default("{}")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company             Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  person              Person?                   @relation(fields: [personId], references: [id], onDelete: SetNull)
  enrichmentLogs      EnrichmentLog[]
  outreachMessages    OutreachMessage[]
  outreachSequences   OutreachSequence[]
  interactionFeedback LeadInteractionFeedback[]
  interactions        Interaction[]
  sequenceStates      LeadSequenceState[]

  @@index([companyId], map: "idx_leads_company_id")
  @@index([personId], map: "idx_leads_person_id")
  @@index([status], map: "idx_leads_status")
  @@index([totalPriorityScore(sort: Desc)], map: "idx_leads_priority")
  @@map("leads")
}

model EnrichmentLog {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  leadId          String?  @map("lead_id") @db.Uuid
  companyId       String?  @map("company_id") @db.Uuid
  provider        String   @db.VarChar(100)
  costCredits     Decimal? @default(0.0000) @map("cost_credits") @db.Decimal(6, 4)
  status          String   @db.VarChar(50)
  responsePayload Json?    @map("response_payload")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lead    Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@map("enrichment_logs")
}

model Campaign {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  icpId              String   @map("icp_id") @db.Uuid
  name               String   @db.VarChar(255)
  isActive           Boolean  @default(true) @map("is_active")
  dailyLimitLinkedin Int      @default(20) @map("daily_limit_linkedin")
  dailyLimitEmail    Int      @default(50) @map("daily_limit_email")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  icpProfile          IcpProfile                @relation(fields: [icpId], references: [id], onDelete: Cascade)
  steps               SequenceStep[]
  messages            OutreachMessage[]
  sequences           OutreachSequence[]
  metrics             CampaignMetric[]
  interactionFeedback LeadInteractionFeedback[]

  @@map("campaigns")
}

model SequenceStep {
  id             String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  campaignId     String      @map("campaign_id") @db.Uuid
  sequenceId     String?     @map("sequence_id") @db.Uuid
  stepOrder      Int         @map("step_order")
  channel        ChannelType
  delayHours     Int         @default(24) @map("delay_hours")
  promptTemplate String      @map("prompt_template") @db.Text
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  branchOn        BranchCondition @default(NONE) @map("branch_on")
  branchStepIndex  Int?            @map("branch_step_index")
  variantGroup     String?         @map("variant_group") @db.VarChar(100)
  variantWeight    Float           @default(1.0) @map("variant_weight")
  active           Boolean         @default(true)
  impressions      Int             @default(0)
  opens            Int             @default(0)
  replies          Int             @default(0)
  clicks           Int             @default(0)

  campaign Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sequence OutreachSequence? @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  messages OutreachMessage[]

  @@map("sequence_steps")
}

model OutreachSequence {
  id               String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  campaignId       String                 @map("campaign_id") @db.Uuid
  status           OutreachSequenceStatus @default(ACTIVE)
  nextStep         Int                    @default(0) @map("next_step")
  nextRunAt        DateTime               @map("next_run_at") @db.Timestamptz(6)
  pausedUntil      DateTime?              @map("paused_until") @db.Timestamptz(6)
  currentVersionId String?                @map("current_version_id") @db.Uuid
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  campaign         Campaign                    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leads            Lead[]
  steps            SequenceStep[]
  versions         OutreachSequenceVersion[]   @relation("SequenceVersions")
  currentVersion   OutreachSequenceVersion?    @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  leadStates       LeadSequenceState[]

  @@index([status, nextRunAt], map: "idx_outreach_sequences_due")
  @@map("outreach_sequences")
}

model OutreachSequenceVersion {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  sequenceId        String   @map("sequence_id") @db.Uuid
  version           Int
  steps             Json
  createdBy         String?  @map("created_by") @db.VarChar(255)
  changeDescription String?  @map("change_description") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sequence           OutreachSequence  @relation("SequenceVersions", fields: [sequenceId], references: [id], onDelete: Cascade)
  currentForSequence OutreachSequence[] @relation("CurrentVersion")
  messages           OutreachMessage[]

  @@unique([sequenceId, version], map: "uq_sequence_versions_sequence_version")
  @@map("outreach_sequence_versions")
}

model LeadSequenceState {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  leadId           String    @map("lead_id") @db.Uuid
  sequenceId       String    @map("sequence_id") @db.Uuid
  currentStepIndex Int       @default(0) @map("current_step_index")
  status           String    @default("ACTIVE") @db.VarChar(50)
  pausedUntil      DateTime? @map("paused_until") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  lead     Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sequence OutreachSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@unique([leadId, sequenceId], map: "uq_lead_sequence_state_lead_sequence")
  @@index([sequenceId, status], map: "idx_lead_sequence_state_sequence_status")
  @@map("lead_sequence_states")
}

model OutreachAccount {
  id          String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  provider    String        @db.VarChar(50)
  externalId  String        @map("external_id") @db.VarChar(255)
  channel     ChannelType
  channelId   String?       @map("channel_id") @db.VarChar(50)
  dailyLimit  Int           @map("daily_limit")
  sentToday   Int           @default(0) @map("sent_today")
  quotaDate   DateTime      @map("quota_date") @db.Date
  pausedUntil DateTime?     @map("paused_until") @db.Timestamptz(6)
  sessionKey  String?       @map("session_key") @db.VarChar(255)
  status      AccountStatus @default(ACTIVE)
  lastError   String?       @map("last_error") @db.Text
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages    OutreachMessage[]

  @@unique([provider, externalId, channel], map: "uq_outreach_account_provider_external_channel")
  @@map("outreach_accounts")
}

model OutreachMessage {
  id                String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  campaignId        String        @map("campaign_id") @db.Uuid
  leadId            String        @map("lead_id") @db.Uuid
  stepId            String        @map("step_id") @db.Uuid
  signalId          String?       @map("signal_id") @db.Uuid
  channel           ChannelType
  channelId         String?       @map("channel_id") @db.VarChar(50)
  subject           String?       @db.VarChar(500)
  body              String        @db.Text
  status            MessageStatus @default(QUEUED)
  externalMessageId String?       @map("external_message_id") @db.VarChar(255)
  outreachAccountId  String?       @map("outreach_account_id") @db.Uuid
  sequenceVersionId  String?       @map("sequence_version_id") @db.Uuid
  scheduledAt        DateTime?     @map("scheduled_at") @db.Timestamptz(6)
  openedAt           DateTime?     @map("opened_at") @db.Timestamptz(6)
  clickedAt          DateTime?     @map("clicked_at") @db.Timestamptz(6)
  errorReason        String?       @map("error_reason") @db.Text
  sentAt             DateTime?     @map("sent_at") @db.Timestamptz(6)
  repliedAt         DateTime?     @map("replied_at") @db.Timestamptz(6)
  replySentiment    String?       @map("reply_sentiment") @db.VarChar(50)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  campaign            Campaign                  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead                Lead                      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  step                SequenceStep              @relation(fields: [stepId], references: [id], onDelete: Cascade)
  signal              IntentSignal?             @relation(fields: [signalId], references: [id], onDelete: SetNull)
  outreachAccount     OutreachAccount?          @relation(fields: [outreachAccountId], references: [id], onDelete: SetNull)
  sequenceVersion     OutreachSequenceVersion?  @relation(fields: [sequenceVersionId], references: [id], onDelete: SetNull)
  interactionFeedback LeadInteractionFeedback[]

  @@index([leadId], map: "idx_outreach_messages_lead")
  @@map("outreach_messages")
}

model CampaignMetric {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  campaignId      String   @map("campaign_id") @db.Uuid
  metricDate      DateTime @map("metric_date") @db.Date
  sentCount       Int      @default(0) @map("sent_count")
  openCount       Int      @default(0) @map("open_count")
  clickCount      Int      @default(0) @map("click_count")
  replyCount      Int      @default(0) @map("reply_count")
  bounceCount     Int      @default(0) @map("bounce_count")
  positiveReplies Int      @default(0) @map("positive_replies")
  negativeReplies Int      @default(0) @map("negative_replies")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, metricDate], map: "uq_campaign_metrics_campaign_date")
  @@index([campaignId, metricDate], map: "idx_campaign_metrics_campaign_date")
  @@map("campaign_metrics")
}

model LeadInteractionFeedback {
  id                  String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  campaignId          String             @map("campaign_id") @db.Uuid
  leadId              String             @map("lead_id") @db.Uuid
  messageId           String?            @map("message_id") @db.Uuid
  interactionType     InteractionType    @map("interaction_type")
  sentiment           FeedbackSentiment?
  confidence          Decimal?           @db.Decimal(5, 2)
  requiresHumanReview Boolean            @default(false) @map("requires_human_review")
  content             String?            @db.Text
  provider            String?            @db.VarChar(100)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  campaign Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  message  OutreachMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([campaignId, createdAt], map: "idx_feedback_campaign_created")
  @@index([leadId, createdAt], map: "idx_feedback_lead_created")
  @@map("lead_interaction_feedback")
}

model Source {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name       String   @db.VarChar(255)
  sourceType String   @map("source_type") @db.VarChar(100)
  sourceUrl  String?  @map("source_url") @db.VarChar(1000)
  externalId String?  @map("external_id") @db.VarChar(255)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  identities      Identity[]
  companyEvidence CompanyEvidence[]
  personEvidence  PersonEvidence[]
  observations    Observation[]
  relationships   Relationship[]
  interactions    Interaction[]
  intentSignals   IntentSignal[]

  @@index([sourceType, externalId], map: "idx_sources_type_external_id")
  @@index([sourceType], map: "idx_sources_type")
  @@map("sources")
}

model Person {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid
  firstName   String?  @map("first_name") @db.VarChar(150)
  lastName    String?  @map("last_name") @db.VarChar(150)
  fullName    String   @map("full_name") @db.VarChar(300)
  title       String?  @db.VarChar(255)
  seniority   String?  @db.VarChar(100)
  linkedinUrl String?  @map("linkedin_url") @db.VarChar(500)
  email       String?  @db.VarChar(255)
  phone       String?  @db.VarChar(50)
  location    String?  @db.VarChar(255)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  company       Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  identities    Identity[]
  leads         Lead[]
  evidence      PersonEvidence[]
  observations  Observation[]
  relationships Relationship[]
  interactions  Interaction[]

  @@index([companyId], map: "idx_people_company_id")
  @@index([fullName], map: "idx_people_full_name")
  @@map("people")
}

model Identity {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  personId        String?   @map("person_id") @db.Uuid
  companyId       String?   @map("company_id") @db.Uuid
  sourceId        String?   @map("source_id") @db.Uuid
  identityType    String    @map("identity_type") @db.VarChar(100)
  value           String    @db.VarChar(500)
  normalizedValue String    @map("normalized_value") @db.VarChar(500)
  isPrimary       Boolean   @default(false) @map("is_primary")
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz(6)
  confidence      Decimal   @default(1.0000) @db.Decimal(5, 4)
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  person  Person?  @relation(fields: [personId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source  Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([identityType, normalizedValue], map: "uq_identities_type_normalized_value")
  @@index([personId], map: "idx_identities_person_id")
  @@index([companyId], map: "idx_identities_company_id")
  @@index([sourceId], map: "idx_identities_source_id")
  @@map("identities")
}

model CompanyEvidence {
  id             String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  companyId      String                 @map("company_id") @db.Uuid
  sourceId       String                 @map("source_id") @db.Uuid
  evidenceType   String                 @map("evidence_type") @db.VarChar(100)
  classification EvidenceClassification
  sourceUrl      String?                @map("source_url") @db.VarChar(1000)
  observedAt     DateTime               @default(now()) @map("observed_at") @db.Timestamptz(6)
  expiresAt      DateTime?              @map("expires_at") @db.Timestamptz(6)
  confidence     Decimal                @default(1.0000) @db.Decimal(5, 4)
  normalizedData Json                   @default("{}") @map("normalized_data")
  rawData        Json?                  @map("raw_data")
  contentHash    String?                @map("content_hash") @db.VarChar(128)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  source        Source         @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  intentSignals IntentSignal[]

  @@index([companyId, evidenceType, observedAt], map: "idx_company_evidence_lookup")
  @@index([sourceId], map: "idx_company_evidence_source_id")
  @@index([expiresAt], map: "idx_company_evidence_expires_at")
  @@map("company_evidence")
}

