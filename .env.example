# Database & Vector Store (PostgreSQL 16 + pgvector)
DATABASE_URL="postgresql://postgres:postgrespassword@127.0.0.1:5433/lookaberry?schema=public"

# Redis Cache & Queues (Redis 7.2)
REDIS_URL="redis://localhost:6379"

# Server Configuration
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"

# AI Models & Embeddings
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Optional Crawler / Scraper Configuration
LOOKACRAWLER_URL=""
JINA_API_KEY=""
FIRECRAWL_API_KEY=""

# Optional enrichment provider credentials. Leave empty to use the safe no-op adapters.
APOLLO_API_KEY=""
DROPCONTACT_API_KEY=""
ZEROBOUNCE_API_KEY=""
