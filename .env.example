[TEMPLATE]
# Database & Vector Store (PostgreSQL 16 + pgvector)
DATABASE_URL="postgresql://postgres:postgrespassword@127.0.0.1:5433/lookaberry?schema=public"

# Redis Cache & Queues (Redis 7.2)
REDIS_URL="redis://localhost:6379"

# Server Configuration
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"

# AI Models & Embeddings
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-latest"
OPENAI_API_KEY=""

# Optional Crawler / Scraper Configuration
LOOKACRAWLER_URL=""
JINA_API_KEY=""
FIRECRAWL_API_KEY=""

# Optional enrichment provider credentials. Leave empty to use the safe no-op adapters.
APOLLO_API_KEY=""
DROPCONTACT_API_KEY=""
ZEROBOUNCE_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# S7: Security hardening
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated list of API keys accepted by the REST API (Bearer or X-API-Key).
API_KEYS=""

# Comma-separated list of API keys with an elevated rate limit tier.
ELEVATED_API_KEYS=""

# HMAC secret for /api/v1/webhooks/outreach signatures (X-Webhook-Signature: t=<ts>,v1=<sig>).
# REQUIRED in production — the server refuses to start without it.
WEBHOOK_SECRET=""

# Comma-separated list of allowed CORS origins. NEVER use "*" with credentials.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:5173"

# Rate limits (requests per minute per client).
RATE_LIMIT_DEFAULT_RPM="100"
RATE_LIMIT_ELEVATED_RPM="300"
RATE_LIMIT_WEBHOOK_RPM="600"

# Maximum accepted JSON body size in bytes.
MAX_BODY_SIZE_BYTES="1048576"

# ─────────────────────────────────────────────────────────────────────────────
# S8: Email execution
# ─────────────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER="none"          # resend | smtp | none
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
EMAIL_REPLY_TO=""
EMAIL_FROM_NAME=""
EMAIL_FROM_ADDRESS=""
EMAIL_TRACKING_ENABLED="true"
# Public base URL used to build tracking pixel / click redirect URLs
PUBLIC_BASE_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# S9: WhatsApp Business Cloud API (Meta Graph API)
# ─────────────────────────────────────────────────────────────────────────────
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANGUAGE="en"
WHATSAPP_FOLLOWUP_TEMPLATE_NAME=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_COUNTRY_CODE="55"

# ─────────────────────────────────────────────────────────────────────────────
# S15: Security & Governance
# ─────────────────────────────────────────────────────────────────────────────
# Salt used for lead anonymization (SHA-256). Change before production.
ANONYMIZATION_SALT="lookaberry-anonymization-v1"

# Whether to run scheduled anonymization on startup (production: true)
ANONYMIZE_ON_STARTUP="false"

# ─────────────────────────────────────────────────────────────────────────────
# S15: IP Filtering (Allowlist / Denylist)
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated list of IPs/CIDR ranges that may access the API.
# When set, ONLY these IPs can reach non-exempt routes (allowlist mode).
# Supports bare IPv4, IPv4 CIDR (/24, /16, etc), IPv6, and "localhost".
IP_ALLOWLIST=""

# Comma-separated list of IPs/CIDR ranges to BLOCK.
# These IPs are rejected even if they pass authentication.
IP_DENYLIST=""

# If set, only these IPs can access admin routes (/api/v1/admin/*).
# Falls back to IP_ALLOWLIST when empty. Use for a smaller blast radius.
ADMIN_IP_ALLOWLIST=""
